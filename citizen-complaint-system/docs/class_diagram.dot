digraph UML {
  graph [rankdir=LR, nodesep=0.45, ranksep=0.8, bgcolor=white, pad=0.3];
  node [shape=plain, fontname="DejaVu Sans", fontsize=13];
  edge [fontname="DejaVu Sans", fontsize=12, color="#37474F"];
  ComplaintRegistry [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E3F2FD" color="#1565C0"><tr><td bgcolor="#1565C0" align="center"><font color="white"><b>ComplaintRegistry</b></font></td></tr><tr><td align="left">- _citizens : dict[str, Citizen]</td></tr><tr><td align="left">- _officers : dict[str, GovernmentOfficer]</td></tr><tr><td align="left">- _complaints : dict[str, Complaint]</td></tr><tr><td align="left" border="1" sides="t">+ add_citizen() / add_officer() / add_complaint()</td></tr><tr><td align="left">+ get_citizen() / get_officer() / get_complaint()</td></tr><tr><td align="left">+ display_complaints() : str</td></tr><tr><td align="left">+ open_complaints() : tuple</td></tr><tr><td align="left">+ overdue_complaints(today) : tuple</td></tr><tr><td align="left">+ count_by(field) : tuple</td></tr><tr><td align="left">+ resolution_rate() : float</td></tr><tr><td align="left">+ export_public_statistics(path) : int</td></tr><tr><td align="left">+ with_sample_data()  «classmethod»</td></tr><tr><td align="left">+ format_counts(rows, label)  «staticmethod»</td></tr></table>>];
  Citizen [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5" color="#6A1B9A"><tr><td bgcolor="#6A1B9A" align="center"><font color="white"><b>Citizen</b></font></td></tr><tr><td align="left">+ citizen_id : str</td></tr><tr><td align="left">+ district : str</td></tr><tr><td align="left">+ language : str</td></tr><tr><td align="left">- _complaint_ids : tuple</td></tr><tr><td align="left" border="1" sides="t">+ submit_complaint(category, text, priority)</td></tr><tr><td align="left">+ update_record(district, language)</td></tr><tr><td align="left">+ display_info(show_codes) : str</td></tr><tr><td align="left">+ generate_id()  «classmethod»</td></tr><tr><td align="left">+ from_tuple(data)  «classmethod»</td></tr></table>>];
  Complaint [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5E9" color="#2E7D32"><tr><td bgcolor="#2E7D32" align="center"><font color="white"><b>Complaint</b></font></td></tr><tr><td align="left">+ complaint_id : str</td></tr><tr><td align="left">+ citizen : Citizen</td></tr><tr><td align="left">+ category / priority / district : str</td></tr><tr><td align="left">+ description : str</td></tr><tr><td align="left">+ submitted_on : date</td></tr><tr><td align="left">- _history : tuple[StatusUpdate]</td></tr><tr><td align="left">+ status / department  «property»</td></tr><tr><td align="left" border="1" sides="t">+ update_status(status, officer_id, note)</td></tr><tr><td align="left">+ is_open() / is_overdue() : bool</td></tr><tr><td align="left">+ days_open() : int</td></tr><tr><td align="left">+ submitted_by() : str</td></tr><tr><td align="left">+ display_info() : str</td></tr><tr><td align="left">+ generate_id()  «classmethod»</td></tr><tr><td align="left">+ categories()  «classmethod»</td></tr><tr><td align="left">+ validate_text(text, ...)  «staticmethod»</td></tr><tr><td align="left">+ department_for(category)  «staticmethod»</td></tr></table>>];
  GovernmentOfficer [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E0F7FA" color="#00838F"><tr><td bgcolor="#00838F" align="center"><font color="white"><b>GovernmentOfficer</b></font></td></tr><tr><td align="left">+ officer_id : str</td></tr><tr><td align="left">+ department : str</td></tr><tr><td align="left">+ district : str</td></tr><tr><td align="left">+ updates_made : int</td></tr><tr><td align="left" border="1" sides="t">+ can_handle(complaint) : bool</td></tr><tr><td align="left">+ handle(complaint, status, note)</td></tr><tr><td align="left">+ display_info() : str</td></tr><tr><td align="left">+ generate_id()  «classmethod»</td></tr><tr><td align="left">+ next_steps(status)  «staticmethod»</td></tr></table>>];
  StatusUpdate [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF3E0" color="#EF6C00"><tr><td bgcolor="#EF6C00" align="center"><font color="white"><b>StatusUpdate</b><br/>«NamedTuple, immutable»</font></td></tr><tr><td align="left">+ status : str</td></tr><tr><td align="left">+ changed_on : date</td></tr><tr><td align="left">+ updated_by : str</td></tr><tr><td align="left">+ note : str</td></tr></table>>];
  ComplaintRegistry -> Citizen [label="stores 0..*\n(dict by code)", dir=back, arrowtail=odiamond, arrowhead=none];
  ComplaintRegistry -> Complaint [label="stores 0..*\n(dict by code)", dir=back, arrowtail=odiamond, arrowhead=none];
  ComplaintRegistry -> GovernmentOfficer [label="stores 0..*\n(dict by code)", dir=back, arrowtail=odiamond, arrowhead=none];
  Citizen -> Complaint [label="submits", arrowhead=vee];
  GovernmentOfficer -> Complaint [label="handles", arrowhead=vee];
  Complaint -> StatusUpdate [label="history 1..*\n(tuple)", dir=back, arrowtail=diamond, arrowhead=none];
}